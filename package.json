{
  "name": "brahmaeorpingtondosul",
  "version": "1.0.0",
  "description": "Criatório Brahma e Orpington do Sul - Landing Page e E-commerce de Ovos Férteis",
  "main": "server.js",
  "scripts": {
    "build": "tailwindcss -i assets/css/input.css -o assets/css/style.css --minify",
